{
  "name": "super-nyangame-2026",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Source-faithful TypeScript and PixiJS revival of Super NyanGame",
  "license": "SEE LICENSE IN LICENSE.md",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "assets": "node scripts/convert-assets.mjs",
    "predev": "npm run assets",
    "prebuild": "npm run assets",
    "pretest": "npm run assets",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "pixi.js": "8.21.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.1",
    "fast-xml-parser": "5.11.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
